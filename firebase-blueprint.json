{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered passenger profile and credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Passenger ticket reservation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "pnr": { "type": "string" },
        "serviceName": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "boardingPoint": { "type": "string" },
        "droppingPoint": { "type": "string" },
        "departureTime": { "type": "string" },
        "arrivalTime": { "type": "string" },
        "travelDate": { "type": "string" },
        "passengers": { "type": "array" },
        "seatIds": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" }
      },
      "required": ["userId", "pnr", "seatIds", "totalAmount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "All transit bookings and reservations"
    }
  }
}
